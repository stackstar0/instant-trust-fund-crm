# =============================================================================
# IFY FINANCIAL CRM — ENVIRONMENT VARIABLES
# =============================================================================
# Copy this file to .env and fill in all values.
# NEVER commit the .env file. It is in .gitignore.
# =============================================================================

# ─── SERVER ──────────────────────────────────────────────────────────────────
NODE_ENV=production
PORT=5000
FRONTEND_URL=https://your-domain.com

# ─── DATABASE ────────────────────────────────────────────────────────────────
# MongoDB Atlas connection string
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/ify_crm?appName=Cluster0

# ─── JWT & SESSION ───────────────────────────────────────────────────────────
# Generate with: node -e "require('crypto').randomBytes(64).toString('hex')"
JWT_SECRET=<generate-64-byte-random-hex>
JWT_REFRESH_SECRET=<generate-another-64-byte-random-hex>

# ─── ENCRYPTION (AES-256-GCM for Aadhaar/PAN) ────────────────────────────────
# MUST be exactly 32 bytes. Generate: node -e "require('crypto').randomBytes(32).toString('hex')"
ENCRYPTION_KEY=<generate-32-byte-random-hex>

# ─── RAZORPAY (Production Payment Gateway) ───────────────────────────────────
# Get from: https://dashboard.razorpay.com/app/keys
RAZORPAY_KEY_ID=rzp_live_xxxxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx
# Get from: Razorpay Dashboard → Webhooks → Webhook Secret
RAZORPAY_WEBHOOK_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ─── SMS GATEWAY (MSG91 — DLT Registered) ────────────────────────────────────
# Get from: https://control.msg91.com
SMS_PROVIDER=msg91
MSG91_AUTH_KEY=<your-msg91-authkey>
MSG91_SENDER_ID=<your-DLT-sender-id>
MSG91_OTP_TEMPLATE_ID=<your-DLT-otp-template-id>
MSG91_APPLICATION_TEMPLATE_ID=<your-application-status-template-id>
MSG91_PAYMENT_TEMPLATE_ID=<your-payment-confirmation-template-id>

# ─── EMAIL (SMTP — Transactional) ────────────────────────────────────────────
# Supported: Gmail (with App Password), Mailgun, AWS SES, SendGrid
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASS=<app-specific-password>
SMTP_FROM="Instant Trust Funds <noreply@instanttrustfunds.com>"

# ─── FILE STORAGE (Cloudflare R2 / AWS S3) ───────────────────────────────────
# For Cloudflare R2: endpoint = https://<account-id>.r2.cloudflarestorage.com
# For AWS S3: endpoint = https://s3.<region>.amazonaws.com
STORAGE_PROVIDER=r2
STORAGE_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
STORAGE_ACCESS_KEY=<your-access-key>
STORAGE_SECRET_KEY=<your-secret-key>
STORAGE_BUCKET=ify-crm-documents
STORAGE_PUBLIC_URL=https://docs.instanttrustfunds.com

# Fallback: local disk (dev only, NOT for production)
# STORAGE_PROVIDER=local

# ─── GOOGLE MAPS (Property Verification) ─────────────────────────────────────
# Get from: https://console.cloud.google.com → Maps JavaScript API
GOOGLE_MAPS_API_KEY=AIza...

# ─── CSRF ────────────────────────────────────────────────────────────────────
# Generate with: node -e "require('crypto').randomBytes(32).toString('hex')"
CSRF_SECRET=<generate-32-byte-random-hex>

# ─── SECURITY ────────────────────────────────────────────────────────────────
# Max failed login attempts before lockout
MAX_LOGIN_ATTEMPTS=5
# Lockout duration in minutes
LOCKOUT_DURATION_MINUTES=30
# Access token expiry (e.g., 15m, 1h)
ACCESS_TOKEN_EXPIRY=15m
# Refresh token expiry (e.g., 7d, 30d)
REFRESH_TOKEN_EXPIRY=7d

# ─── EXTERNAL INTEGRATIONS (GOOGLE OAUTH, BHOOMI, MESSAGEBOT) ────────────────
# Google OAuth 2.0
GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-google-client-secret"

# Bhoomi (API Setu) Integration
BHOOMI_API_KEY="your-api-setu-key"
BHOOMI_CLIENT_ID="your-api-setu-client-id"
BHOOMI_CLIENT_SECRET="your-api-setu-client-secret"

# MessageBot SMS Integration
MESSAGEBOT_API_TOKEN="your-messagebot-api-token"
MESSAGEBOT_SENDER_ID="TRUSTF"
DLT_ENTITY_ID="1234567890123456789"
DLT_TEMPLATE_ID="9876543210987654321"
